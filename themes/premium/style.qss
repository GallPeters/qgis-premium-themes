/* =========================================================================
 * QGIS Premium Dark Theme  —  Windows 11 / Qt6 refinement
 * -------------------------------------------------------------------------
 * Compatible with: QGIS 4.0 / Qt6 theme system (PR #64503)
 * Companion file : variables.qss   (defines all `@*` tokens used below)
 *
 * Design language:
 *   - Native Windows 11 metrics (small radii, hairline borders, compact padding)
 *   - Subtle tonal hierarchy, no gradients, no decorative shadows
 *   - Soft hover states (bg only), 1px accent focus border, tactile pressed state
 *   - Accent used sparingly: focus rings, selected items, primary buttons,
 *     progress chunks, sliders, indicator fills.
 * =========================================================================
 * ORGANISATION
 *   1.  Global / QWidget defaults
 *   2.  Top-level containers (MainWindow, Dialog, StatusBar, DockWidget)
 *   3.  Toolbars, menus, menu bar
 *   4.  Buttons (push, tool, default, disabled)
 *   5.  Text inputs (line, text, plain)
 *   6.  Numeric inputs (spinbox, date/time, QgsSpinBox, QgsDoubleSpinBox)
 *   7.  ComboBox + popup view
 *   8.  Item views (list / tree / table - generic)
 *   9.  Tabs (QTabWidget / QTabBar)
 *  10.  Scrollbars
 *  11.  Indicators (checkbox, radio)
 *  12.  Containers (groupbox, splitter, frame)
 *  13.  Feedback widgets (progress, slider, tooltip, rubber band)
 *  14.  QGIS-specific widgets
 *  15.  Plugin Manager list (named selectors)
 *  16.  Options / Navigation lists & trees (named selectors)
 *  17.  Layer Styling dock
 * =========================================================================
 */


/* =========================================================================
 * 1.  GLOBAL / QWidget DEFAULTS
 * ========================================================================= */

* {
    outline: 0;
    color: @text;
    selection-background-color: @accent;
    selection-color: @text_dark;
}

QWidget {
    background-color: @bg_window;
    color: @text;
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 9pt;
    border: none;
}

QWidget:disabled {
    color: @text_disabled;
    background-color: @bg_window;
}

QToolTip {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @border;
    padding: 6px 10px;
    border-radius: 4px;
}


/* =========================================================================
 * 2.  TOP-LEVEL CONTAINERS
 * ========================================================================= */

QMainWindow {
    background-color: @bg_window;
    color: @text;
}
QMainWindow::separator {
    background-color: @border_subtle;
    width:  1px;
    height: 1px;
}
QMainWindow::separator:hover {
    background-color: @accent;
}

QDialog {
    background-color: @bg_window;
    color: @text;
}

QStatusBar {
    background-color: @bg_statusbar;
    color: @text_dim;
    border-top: 1px solid @border_subtle;
    min-height: 26px;
    padding: 2px 6px;
}
QStatusBar::item {
    border: 0;
    padding: 0;
}
QStatusBar QLabel {
    background: transparent;
    color: @text_dim;
    padding: 0 4px;
    min-height: 20px;
}
QStatusBar QToolButton,
QStatusBar QPushButton {
    padding: 2px 8px;
    margin: 1px;
    min-height: 20px;
    min-width: 0;
    border-radius: 3px;
}
QStatusBar QToolButton:hover,
QStatusBar QPushButton:hover {
    background-color: @bg_hover_raised;
    border: 1px solid @border_subtle;
}
QStatusBar QLineEdit,
QStatusBar QComboBox {
    padding: 2px 6px;
    margin: 1px;
    min-height: 20px;
}

QSizeGrip {
    background: transparent;
    width:  14px;
    height: 14px;
}

QDockWidget {
    background-color: @bg_dock;
    color: @text;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: 1px solid @border_subtle;
}
QDockWidget::title {
    background-color: @bg_window;
    color: @text_light;
    padding: 5px 10px;
    border-bottom: 1px solid @border_subtle;
    text-align: left;
    font-weight: 600;
}
QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: 0;
    padding: 2px;
    border-radius: 3px;
    icon-size: 12px;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: @bg_hover_raised;
}
QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: @bg_pressed;
}


/* =========================================================================
 * 3.  TOOLBARS, MENUS, MENU BAR
 * ========================================================================= */

QToolBar {
    background-color: @bg_window;
    border: none;
    border-bottom: 1px solid @border_subtle;
    spacing: 2px;
    padding: 2px 4px;
}
QToolBar::separator {
    background-color: @border_subtle;
    width: 1px;
    margin: 4px 5px;
}
QToolBar::handle {
    background: transparent;
    width: 6px;
}

QMenuBar {
    background-color: @bg_window;
    color: @text;
    border-bottom: 1px solid @border_subtle;
    padding: 2px 4px;
    font-size: 9pt;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    margin: 0 1px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: @bg_hover_raised;
    color: @text_bright;
}
QMenuBar::item:pressed {
    background-color: @bg_selected_active;
    color: @text_bright;
}

QMenu {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
    margin: 1px 2px;
    min-height: 18px;
}
QMenu::item:selected {
    background-color: @bg_hover_raised;
    color: @text_bright;
}
QMenu::item:disabled {
    color: @text_disabled;
    background: transparent;
}
QMenu::icon {
    padding-left: 6px;
}
QMenu::separator {
    height: 1px;
    background-color: @border_subtle;
    margin: 4px 10px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 6px;
}


/* =========================================================================
 * 4.  BUTTONS
 * ========================================================================= */

QPushButton {
    background-color: @bg_selected_inactive;
    color: @text;
    border: 1px solid @border_btn;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 22px;
    min-width:  72px;
}
QPushButton:hover {
    background-color: @bg_btn_hover;
    border-color: @border_btn;
}
QPushButton:pressed {
    background-color: @bg_pressed;
    border-color: @border_subtle;
}
QPushButton:checked {
    background-color: @bg_selected_active;
    border-color: @accent_checked_border;
    color: @text_bright;
}
QPushButton:focus {
    border-color: @accent;
}
QPushButton:default {
    background-color: @accent;
    color: @text_dark;
    border: 1px solid @accent_pressed;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: @accent_hover;
    border-color: @accent;
}
QPushButton:default:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}
QPushButton:default:focus {
    border-color: @accent;
}
QPushButton:disabled {
    background-color: @bg_disabled;
    color: @text_disabled;
    border-color: @bg_disabled;
}
QPushButton:default:disabled {
    background-color: @accent_disabled;
    color: @text_disabled;
    border-color: @accent_disabled;
}
QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 6px;
    width: 10px;
}

QToolButton {
    background: transparent;
    color: @text;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 5px;
    margin: 1px;
}
QToolButton[popupMode="1"] {
    padding-right: 18px;
}
QToolButton[popupMode="2"] {
    padding-right: 14px;
}
QToolButton::menu-indicator {
    subcontrol-origin:   padding;
    subcontrol-position: bottom right;
    right:  2px;
    bottom: 2px;
}
QToolButton::menu-button {
    border-left: 1px solid @border_subtle;
    border-top-right-radius:    4px;
    border-bottom-right-radius: 4px;
    width: 14px;
    background: transparent;
}
QToolButton::menu-button:hover {
    background-color: @bg_hover_raised;
}
QToolButton:hover {
    background-color: @bg_hover_raised;
    border-color: transparent;
}
QToolButton:pressed {
    background-color: @bg_pressed;
}
QToolButton:checked {
    background-color: @bg_selected;
    border-color: @accent_checked_border;
}
QToolButton:checked:hover {
    background-color: @bg_selected_active;
    border-color: @accent_pressed;
}
QToolButton:disabled {
    color: @text_disabled;
    background: transparent;
}


/* =========================================================================
 * 5.  TEXT INPUTS
 * ========================================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: @accent;
    selection-color: @text_dark;
    placeholder-text-color: @text_placeholder;
}
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: @border_hover;
}
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: @accent;
    background-color: @bg_alt;
}
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: @bg_alt;
    color: @text_disabled;
    border-color: @border_dim;
}
QLineEdit:read-only {
    background-color: @bg_alt;
    color: @text_dim;
}


/* =========================================================================
 * 6.  NUMERIC / DATE INPUTS (incl. QGIS subclasses)
 * ========================================================================= */

QSpinBox, QDoubleSpinBox,
QDateEdit, QDateTimeEdit, QTimeEdit,
QgsSpinBox, QgsDoubleSpinBox {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 8px;
    padding-right: 22px;
    min-height: 22px;
    min-width:  64px;
    selection-background-color: @accent;
    selection-color: @text_dark;
}
QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QDateTimeEdit:hover, QTimeEdit:hover,
QgsSpinBox:hover, QgsDoubleSpinBox:hover {
    border-color: @border_hover;
}
QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus,
QgsSpinBox:focus, QgsDoubleSpinBox:focus {
    border-color: @accent;
    background-color: @bg_alt;
}
QSpinBox:disabled, QDoubleSpinBox:disabled,
QDateEdit:disabled, QDateTimeEdit:disabled, QTimeEdit:disabled,
QgsSpinBox:disabled, QgsDoubleSpinBox:disabled {
    background-color: @bg_alt;
    color: @text_disabled;
    border-color: @border_dim;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QDateTimeEdit::up-button, QTimeEdit::up-button,
QgsSpinBox::up-button, QgsDoubleSpinBox::up-button {
    subcontrol-origin:   border;
    subcontrol-position: top right;
    width: 18px;
    background-color: transparent;
    border: none;
    border-left: 1px solid @border_subtle;
    border-top-right-radius: 3px;
}
QSpinBox::up-button:hover,   QDoubleSpinBox::up-button:hover,
QDateEdit::up-button:hover,  QDateTimeEdit::up-button:hover, QTimeEdit::up-button:hover,
QgsSpinBox::up-button:hover, QgsDoubleSpinBox::up-button:hover {
    background-color: @bg_hover_raised;
}
QSpinBox::up-button:pressed,   QDoubleSpinBox::up-button:pressed,
QDateEdit::up-button:pressed,  QDateTimeEdit::up-button:pressed, QTimeEdit::up-button:pressed,
QgsSpinBox::up-button:pressed, QgsDoubleSpinBox::up-button:pressed {
    background-color: @bg_pressed;
}

QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QDateTimeEdit::down-button, QTimeEdit::down-button,
QgsSpinBox::down-button, QgsDoubleSpinBox::down-button {
    subcontrol-origin:   border;
    subcontrol-position: bottom right;
    width: 18px;
    background-color: transparent;
    border: none;
    border-left: 1px solid @border_subtle;
    border-bottom-right-radius: 3px;
}
QSpinBox::down-button:hover,   QDoubleSpinBox::down-button:hover,
QDateEdit::down-button:hover,  QDateTimeEdit::down-button:hover, QTimeEdit::down-button:hover,
QgsSpinBox::down-button:hover, QgsDoubleSpinBox::down-button:hover {
    background-color: @bg_hover_raised;
}
QSpinBox::down-button:pressed,   QDoubleSpinBox::down-button:pressed,
QDateEdit::down-button:pressed,  QDateTimeEdit::down-button:pressed, QTimeEdit::down-button:pressed,
QgsSpinBox::down-button:pressed, QgsDoubleSpinBox::down-button:pressed {
    background-color: @bg_pressed;
}

/* Arrow glyph sizes — Qt's underlying style renders the glyph using palette colours. */
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow, QDateTimeEdit::up-arrow, QTimeEdit::up-arrow,
QgsSpinBox::up-arrow, QgsDoubleSpinBox::up-arrow {
    width: 9px;
    height: 9px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow, QDateTimeEdit::down-arrow, QTimeEdit::down-arrow,
QgsSpinBox::down-arrow, QgsDoubleSpinBox::down-arrow {
    width: 9px;
    height: 9px;
}


/* =========================================================================
 * 7.  COMBOBOX
 * ========================================================================= */

QComboBox {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 9px;
    min-height: 22px;
    min-width:  64px;
    selection-background-color: @accent;
    selection-color: @text_dark;
}
QComboBox:hover {
    border-color: @border_hover;
}
QComboBox:focus,
QComboBox:on {
    border-color: @accent;
    background-color: @bg_alt;
}
QComboBox:disabled {
    background-color: @bg_alt;
    color: @text_disabled;
    border-color: @border_dim;
}

QComboBox QAbstractItemView {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: @bg_hover_raised;
    selection-color: @text_bright;
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 4px;
    min-height: 20px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: @bg_hover_raised;
    color: @text_bright;
}
QComboBox QAbstractItemView::item:selected {
    background-color: @bg_selected;
    color: @text_bright;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background: transparent;
}
QComboBox::drop-down:hover {
    background-color: @bg_hover_raised;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox::down-arrow {
    width: 9px;
    height: 9px;
}


/* =========================================================================
 * 8.  ITEM VIEWS (LIST / TREE / TABLE - generic defaults)
 * ========================================================================= */

QListView, QListWidget,
QTreeView, QTreeWidget {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    alternate-background-color: @bg_alt;
    selection-background-color: @bg_selected;
    selection-color: @text_bright;
    outline: none;
    show-decoration-selected: 1;
}
QListView::item, QListWidget::item,
QTreeView::item, QTreeWidget::item {
    padding: 4px 6px;
    border: none;
    color: @text;
    min-height: 20px;
}
QListView::item:hover, QListWidget::item:hover,
QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QListView::item:selected, QListWidget::item:selected,
QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: @bg_selected;
    color: @text_bright;
}
QListView::item:selected:active, QListWidget::item:selected:active,
QTreeView::item:selected:active, QTreeWidget::item:selected:active {
    background-color: @bg_selected_active;
    color: @text_bright;
}
QListView::item:selected:!active, QListWidget::item:selected:!active,
QTreeView::item:selected:!active, QTreeWidget::item:selected:!active {
    background-color: @bg_selected_inactive;
    color: @text;
}

QTableView, QTableWidget {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    alternate-background-color: @bg_alt;
    gridline-color: @border_subtle;
    selection-background-color: @bg_selected;
    selection-color: @text_bright;
    outline: none;
}
QTableView::item, QTableWidget::item {
    padding: 4px 6px;
    border: none;
    color: @text;
}
QTableView::item:hover, QTableWidget::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QTableView::item:selected, QTableWidget::item:selected {
    background-color: @bg_selected;
    color: @text_bright;
}
QTableView::item:selected:active, QTableWidget::item:selected:active {
    background-color: @bg_selected_active;
    color: @text_bright;
}

QTableCornerButton::section {
    background-color: @border_list_item;
    border: none;
    border-right:  1px solid @border_subtle;
    border-bottom: 1px solid @border_subtle;
}

QHeaderView {
    background-color: @border_list_item;
    color: @text_header;
    border: none;
    font-weight: 600;
}
QHeaderView::section {
    background-color: @border_list_item;
    color: @text_header;
    padding: 5px 8px;
    border: none;
    border-right:  1px solid @border_subtle;
    border-bottom: 1px solid @border_subtle;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: @bg_hover_raised;
    color: @text_bright;
}
QHeaderView::section:checked {
    background-color: @bg_selected_inactive;
    color: @text_bright;
}
QHeaderView::section:first {
    border-top-left-radius: 3px;
}
QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 3px;
}

QAbstractItemView {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    selection-background-color: @bg_selected;
    selection-color: @text_bright;
    alternate-background-color: @bg_alt;
    outline: none;
    show-decoration-selected: 1;
}
QAbstractItemView::item {
    border: none;
    color: @text;
}
QAbstractItemView::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QAbstractItemView::item:selected {
    background-color: @bg_selected;
    color: @text_bright;
}


/* =========================================================================
 * 9.  TABS
 * -------------------------------------------------------------------------
 * Win11-style flat tabs: idle tabs are transparent with no chrome; only the
 * selected tab is differentiated by a 2px accent underline + brighter text.
 * ========================================================================= */

QTabWidget::pane {
    background-color: @bg_window;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    top: -1px;
}
QTabWidget::tab-bar {
    alignment: left;
    left: 4px;
}
QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: transparent;
    color: @text_dim;
    border: 1px solid transparent;
    padding: 6px 14px;
    min-width: 60px;
    min-height: 18px;
}
QTabBar::tab:top {
    border-top-left-radius:  4px;
    border-top-right-radius: 4px;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}
QTabBar::tab:bottom {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top: 2px solid transparent;
    margin-right: 2px;
}
QTabBar::tab:left {
    border-top-left-radius:    4px;
    border-bottom-left-radius: 4px;
    border-right: 2px solid transparent;
    padding: 8px 10px;
    margin-bottom: 2px;
    min-width: 28px;
}
QTabBar::tab:right {
    border-top-right-radius:    4px;
    border-bottom-right-radius: 4px;
    border-left: 2px solid transparent;
    padding: 8px 10px;
    margin-bottom: 2px;
    min-width: 28px;
}
QTabBar::tab:hover {
    background-color: @bg_hover_raised;
    color: @text;
}
QTabBar::tab:selected {
    color: @text_bright;
    background-color: transparent;
}
QTabBar::tab:selected:top    { border-bottom-color: @accent; }
QTabBar::tab:selected:bottom { border-top-color:    @accent; }
QTabBar::tab:selected:left   { border-right-color:  @accent; }
QTabBar::tab:selected:right  { border-left-color:   @accent; }
QTabBar::tab:disabled {
    color: @text_disabled;
}
QTabBar::close-button {
    background: transparent;
    border-radius: 3px;
    padding: 2px;
}
QTabBar::close-button:hover {
    background-color: @bg_hover_raised;
}


/* =========================================================================
 * 10. SCROLLBARS  (Win11 thin overlay style)
 * ========================================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: @border_btn;
    min-height: 28px;
    border-radius: 4px;
    margin: 2px 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_handle_hover;
}
QScrollBar::handle:vertical:pressed {
    background-color: @text_dim;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: transparent;
    height: 0;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: @border_btn;
    min-width: 28px;
    border-radius: 4px;
    margin: 2px 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_handle_hover;
}
QScrollBar::handle:horizontal:pressed {
    background-color: @text_dim;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: transparent;
    width: 0;
    border: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::corner {
    background-color: transparent;
}


/* =========================================================================
 * 11. INDICATORS (Checkbox / Radio)
 * ========================================================================= */

QCheckBox {
    background: transparent;
    color: @text;
    spacing: 8px;
    padding: 2px 0;
}
QCheckBox:disabled {
    color: @text_disabled;
}
QCheckBox::indicator {
    width:  16px;
    height: 16px;
    border: 1px solid @border_indicator;
    background-color: @bg_indicator;
    border-radius: 3px;
}
QCheckBox::indicator:hover {
    border-color: @accent;
    background-color: @border_list_item;
}
QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}
QCheckBox::indicator:checked:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QCheckBox::indicator:indeterminate {
    background-color: @accent_indeterminate;
    border-color: @accent_pressed;
}
QCheckBox::indicator:disabled {
    background-color: @bg_disabled;
    border-color: @bg_selected_inactive;
}
QCheckBox::indicator:checked:disabled {
    background-color: @accent_disabled;
    border-color: @accent_disabled;
}

QRadioButton {
    background: transparent;
    color: @text;
    spacing: 8px;
    padding: 2px 0;
}
QRadioButton:disabled {
    color: @text_disabled;
}
QRadioButton::indicator {
    width:  16px;
    height: 16px;
    border: 1px solid @border_indicator;
    background-color: @bg_indicator;
    border-radius: 8px;
}
QRadioButton::indicator:hover {
    border-color: @accent;
    background-color: @border_list_item;
}
QRadioButton::indicator:checked {
    background-color: @accent;
    border: 1px solid @accent;
    border-radius: 8px;
}
QRadioButton::indicator:checked:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QRadioButton::indicator:disabled {
    background-color: @bg_disabled;
    border-color: @bg_selected_inactive;
}
QRadioButton::indicator:checked:disabled {
    background-color: @accent_disabled;
    border-color: @accent_disabled;
}


/* =========================================================================
 * 12. CONTAINERS (GroupBox / Splitter / Frame)
 * ========================================================================= */

QGroupBox {
    background-color: transparent;
    color: @text_light;
    border: 1px solid @border_subtle;
    border-radius: 6px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin:   margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: @bg_window;
    color: @text_header;
}
QGroupBox:disabled {
    color: @text_disabled;
    border-color: @border_dim;
}

QSplitter {
    background-color: @bg_window;
}
QSplitter::handle {
    background-color: @border_subtle;
}
QSplitter::handle:horizontal { width:  1px; }
QSplitter::handle:vertical   { height: 1px; }
QSplitter::handle:hover      { background-color: @accent; }
QSplitter::handle:pressed    { background-color: @accent_pressed; }

QFrame {
    background-color: transparent;
    border: none;
}
/* Panel / Box / StyledPanel frame shapes */
QFrame[frameShape="2"],
QFrame[frameShape="3"],
QFrame[frameShape="6"] {
    border: 1px solid @border_subtle;
    border-radius: 4px;
}
/* HLine */
QFrame[frameShape="4"] {
    background-color: @border_subtle;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
/* VLine */
QFrame[frameShape="5"] {
    background-color: @border_subtle;
    border: none;
    max-width: 1px;
    min-width: 1px;
}

QScrollArea {
    background: transparent;
    border: none;
}


/* =========================================================================
 * 13. FEEDBACK WIDGETS (ProgressBar / Slider / RubberBand)
 * ========================================================================= */

QProgressBar {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    text-align: center;
    min-height: 16px;
    font-weight: 600;
}
QProgressBar::chunk {
    background-color: @accent;
    border-radius: 3px;
    margin: 1px;
}
QProgressBar:disabled {
    color: @text_disabled;
}
QProgressBar:disabled::chunk {
    background-color: @accent_disabled;
}

QSlider {
    background: transparent;
}
QSlider::groove:horizontal {
    background-color: @bg_pressed;
    height: 4px;
    border-radius: 2px;
    border: none;
}
QSlider::sub-page:horizontal {
    background-color: @accent;
    border-radius: 2px;
    height: 4px;
}
QSlider::handle:horizontal {
    background-color: @text_light;
    border: 1px solid @border_btn;
    width:  14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background-color: @text_bright;
    border-color: @accent;
}
QSlider::handle:horizontal:pressed {
    background-color: @accent;
    border-color: @accent;
}
QSlider::groove:vertical {
    background-color: @bg_pressed;
    width: 4px;
    border-radius: 2px;
    border: none;
}
QSlider::sub-page:vertical {
    background-color: @bg_pressed;
    border-radius: 2px;
}
QSlider::add-page:vertical {
    background-color: @accent;
    border-radius: 2px;
}
QSlider::handle:vertical {
    background-color: @text_light;
    border: 1px solid @border_btn;
    width:  14px;
    height: 14px;
    margin: 0 -6px;
    border-radius: 8px;
}
QSlider::handle:vertical:hover {
    background-color: @text_bright;
    border-color: @accent;
}

QStackedWidget {
    background-color: @bg_window;
    border: none;
}

QRubberBand {
    background-color: @accent_translucent;
    border: 1px solid @accent;
    border-radius: 2px;
}


/* =========================================================================
 * 14. QGIS-SPECIFIC WIDGETS
 * ========================================================================= */

/* ---- Collapsible group boxes ---- */
QgsCollapsibleGroupBox,
QgsCollapsibleGroupBoxBasic {
    background-color: transparent;
    color: @text_light;
    border: 1px solid @border_subtle;
    border-radius: 6px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
    font-weight: 600;
}
QgsCollapsibleGroupBox::title,
QgsCollapsibleGroupBoxBasic::title {
    subcontrol-origin:   margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: @bg_window;
    color: @text_header;
}

/* ---- Filter / search line edits (locator, attribute filters) ---- */
QgsFilterLineEdit {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
}
QgsFilterLineEdit:hover {
    border-color: @border_hover;
}
QgsFilterLineEdit:focus {
    border-color: @accent;
    background-color: @bg_alt;
}

/* ---- QGIS comboboxes (inherit standard QComboBox styling) ---- */
QgsMapLayerComboBox,
QgsFieldComboBox,
QgsProjectionSelectionWidget,
QgsScaleComboBox,
QgsCheckableComboBox,
QgsFeatureListComboBox,
QgsRasterBandComboBox,
QgsFontComboBox {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 3px 9px;
    min-height: 22px;
    min-width:  64px;
}
QgsMapLayerComboBox:hover,
QgsFieldComboBox:hover,
QgsProjectionSelectionWidget:hover,
QgsScaleComboBox:hover,
QgsCheckableComboBox:hover,
QgsFeatureListComboBox:hover,
QgsRasterBandComboBox:hover,
QgsFontComboBox:hover {
    border-color: @border_hover;
}
QgsMapLayerComboBox:focus,
QgsFieldComboBox:focus,
QgsProjectionSelectionWidget:focus,
QgsScaleComboBox:focus,
QgsCheckableComboBox:focus,
QgsFeatureListComboBox:focus,
QgsRasterBandComboBox:focus,
QgsFontComboBox:focus {
    border-color: @accent;
    background-color: @bg_alt;
}

/* ---- Colour / ramp pickers ---- */
QgsColorButton,
QgsColorRampButton {
    border: 1px solid @border;
    border-radius: 4px;
    padding: 2px;
    background-color: @bg_base;
    min-height: 22px;
}
QgsColorButton:hover,
QgsColorRampButton:hover {
    border-color: @border_hover;
}
QgsColorButton:focus,
QgsColorRampButton:focus {
    border-color: @accent;
}

/* ---- Layer panel / Browser / Processing toolbox / Attribute table ---- */
QgsLayerTreeView,
QgsBrowserDockWidget QTreeView,
QgsBrowserTreeView,
QgsProcessingToolboxTreeView,
QgsLocatorWidget,
QgsAttributeTableView {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    alternate-background-color: @bg_alt;
    selection-background-color: @bg_selected;
    selection-color: @text_bright;
    outline: none;
    show-decoration-selected: 1;
}
QgsLayerTreeView::item,
QgsBrowserDockWidget QTreeView::item,
QgsBrowserTreeView::item,
QgsProcessingToolboxTreeView::item,
QgsAttributeTableView::item {
    padding: 4px 4px;
    border: none;
    color: @text;
    min-height: 20px;
}
QgsLayerTreeView::item:hover,
QgsBrowserDockWidget QTreeView::item:hover,
QgsBrowserTreeView::item:hover,
QgsProcessingToolboxTreeView::item:hover,
QgsAttributeTableView::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QgsLayerTreeView::item:selected,
QgsBrowserDockWidget QTreeView::item:selected,
QgsBrowserTreeView::item:selected,
QgsProcessingToolboxTreeView::item:selected,
QgsAttributeTableView::item:selected {
    background-color: @bg_selected;
    color: @text_bright;
}
QgsLayerTreeView::item:selected:active,
QgsBrowserDockWidget QTreeView::item:selected:active,
QgsBrowserTreeView::item:selected:active,
QgsProcessingToolboxTreeView::item:selected:active,
QgsAttributeTableView::item:selected:active {
    background-color: @bg_selected_active;
    color: @text_bright;
}
QgsLayerTreeView::item:selected:!active,
QgsBrowserDockWidget QTreeView::item:selected:!active,
QgsBrowserTreeView::item:selected:!active,
QgsProcessingToolboxTreeView::item:selected:!active,
QgsAttributeTableView::item:selected:!active {
    background-color: @bg_selected_inactive;
    color: @text;
}

/* ---- Code editors ---- */
QgsCodeEditor,
QgsCodeEditorPython,
QgsCodeEditorSQL,
QgsCodeEditorExpression,
QgsCodeEditorHTML,
QgsCodeEditorJavascript,
QgsCodeEditorCSS {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    selection-background-color: @bg_selected;
    selection-color: @text_bright;
}

/* ---- Message bar ---- */
QgsMessageBar {
    background-color: @bg_alt;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    padding: 5px 10px;
}


/* =========================================================================
 * 15. PLUGIN MANAGER LIST (named selectors)
 * -------------------------------------------------------------------------
 * Recognised object names: `vwPlugins`, `mListPlugins`, `mPluginsList`.
 * ========================================================================= */

QListView#vwPlugins,        QListWidget#vwPlugins,
QListView#mListPlugins,     QListWidget#mListPlugins,
QListView#mPluginsList,     QListWidget#mPluginsList {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    outline: 0;
    alternate-background-color: @bg_alt;
    selection-background-color: @bg_selected_active;
    selection-color: @text_bright;
    show-decoration-selected: 1;
    padding: 2px;
}
QListView#vwPlugins::item,    QListWidget#vwPlugins::item,
QListView#mListPlugins::item, QListWidget#mListPlugins::item,
QListView#mPluginsList::item, QListWidget#mPluginsList::item {
    background-color: transparent;
    color: @text;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid @border_subtle;
    min-height: 32px;
    margin: 0;
}
QListView#vwPlugins::item:hover,    QListWidget#vwPlugins::item:hover,
QListView#mListPlugins::item:hover, QListWidget#mListPlugins::item:hover,
QListView#mPluginsList::item:hover, QListWidget#mPluginsList::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QListView#vwPlugins::item:selected,            QListWidget#vwPlugins::item:selected,
QListView#mListPlugins::item:selected,         QListWidget#mListPlugins::item:selected,
QListView#mPluginsList::item:selected,         QListWidget#mPluginsList::item:selected,
QListView#vwPlugins::item:selected:active,     QListWidget#vwPlugins::item:selected:active,
QListView#mListPlugins::item:selected:active,  QListWidget#mListPlugins::item:selected:active,
QListView#mPluginsList::item:selected:active,  QListWidget#mPluginsList::item:selected:active {
    background-color: @bg_selected_active;
    color: @text_bright;
}
QListView#vwPlugins::item:selected:hover,    QListWidget#vwPlugins::item:selected:hover,
QListView#mListPlugins::item:selected:hover, QListWidget#mListPlugins::item:selected:hover,
QListView#mPluginsList::item:selected:hover, QListWidget#mPluginsList::item:selected:hover {
    background-color: @bg_plugin_sel_hover;
    color: @text_bright;
}
QListView#vwPlugins::item:selected:!active,    QListWidget#vwPlugins::item:selected:!active,
QListView#mListPlugins::item:selected:!active, QListWidget#mListPlugins::item:selected:!active,
QListView#mPluginsList::item:selected:!active, QListWidget#mPluginsList::item:selected:!active {
    background-color: @bg_plugin_inactive;
    color: @text;
}
QListView#vwPlugins::item:focus,    QListWidget#vwPlugins::item:focus,
QListView#mListPlugins::item:focus, QListWidget#mListPlugins::item:focus,
QListView#mPluginsList::item:focus, QListWidget#mPluginsList::item:focus {
    background-color: @bg_selected_active;
    color: @text_bright;
}


/* =========================================================================
 * 16. OPTIONS / NAVIGATION LISTS & TREES (named selectors)
 * -------------------------------------------------------------------------
 * Targets: mOptListWidget, mOptionsListWidget, mWidgetMenu, mNavigationList,
 *          mTabsList, mOptionsTreeView, QgsOptionsTreeView, etc.
 * ========================================================================= */

/* ---- Navigation LIST widgets ---- */
QListWidget#mOptListWidget,      QListView#mOptListWidget,
QListWidget#mOptionsListWidget,  QListView#mOptionsListWidget,
QListWidget#mWidgetMenu,         QListView#mWidgetMenu,
QListWidget#mNavigationList,     QListView#mNavigationList,
QListWidget#mTabsList,           QListView#mTabsList {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    outline: none;
    alternate-background-color: @bg_alt;
    padding: 3px;
}
QListWidget#mOptListWidget::item,     QListView#mOptListWidget::item,
QListWidget#mOptionsListWidget::item, QListView#mOptionsListWidget::item,
QListWidget#mWidgetMenu::item,        QListView#mWidgetMenu::item,
QListWidget#mNavigationList::item,    QListView#mNavigationList::item,
QListWidget#mTabsList::item,          QListView#mTabsList::item {
    background-color: transparent;
    color: @text;
    padding: 7px 10px;
    border: none;
    border-radius: 4px;
    margin: 1px 2px;
    min-height: 22px;
}
QListWidget#mOptListWidget::item:hover,     QListView#mOptListWidget::item:hover,
QListWidget#mOptionsListWidget::item:hover, QListView#mOptionsListWidget::item:hover,
QListWidget#mWidgetMenu::item:hover,        QListView#mWidgetMenu::item:hover,
QListWidget#mNavigationList::item:hover,    QListView#mNavigationList::item:hover,
QListWidget#mTabsList::item:hover,          QListView#mTabsList::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QListWidget#mOptListWidget::item:selected,     QListView#mOptListWidget::item:selected,
QListWidget#mOptionsListWidget::item:selected, QListView#mOptionsListWidget::item:selected,
QListWidget#mWidgetMenu::item:selected,        QListView#mWidgetMenu::item:selected,
QListWidget#mNavigationList::item:selected,    QListView#mNavigationList::item:selected,
QListWidget#mTabsList::item:selected,          QListView#mTabsList::item:selected {
    background-color: @bg_selected_active;
    color: @text_bright;
}
QListWidget#mOptListWidget::item:selected:!active,     QListView#mOptListWidget::item:selected:!active,
QListWidget#mOptionsListWidget::item:selected:!active, QListView#mOptionsListWidget::item:selected:!active,
QListWidget#mWidgetMenu::item:selected:!active,        QListView#mWidgetMenu::item:selected:!active,
QListWidget#mNavigationList::item:selected:!active,    QListView#mNavigationList::item:selected:!active,
QListWidget#mTabsList::item:selected:!active,          QListView#mTabsList::item:selected:!active {
    background-color: @bg_selected_inactive;
    color: @text;
}

/* ---- Navigation TREE widgets (incl. QGIS QgsOptionsTreeView/Widget) ---- */
QTreeWidget#mOptionsTreeView,   QTreeView#mOptionsTreeView,
QTreeWidget#mOptionsTreeWidget, QTreeView#mOptionsTreeWidget,
QTreeWidget#mOptionsTree,       QTreeView#mOptionsTree,
QTreeWidget#mNavigationTree,    QTreeView#mNavigationTree,
QgsOptionsTreeView, QgsOptionsTreeWidget {
    background-color: @bg_base;
    color: @text;
    border: 1px solid @border_subtle;
    border-radius: 4px;
    outline: none;
    alternate-background-color: @bg_alt;
    padding: 3px;
    show-decoration-selected: 1;
    selection-background-color: @bg_selected_active;
    selection-color: @text_bright;
}
QTreeWidget#mOptionsTreeView::item,   QTreeView#mOptionsTreeView::item,
QTreeWidget#mOptionsTreeWidget::item, QTreeView#mOptionsTreeWidget::item,
QTreeWidget#mOptionsTree::item,       QTreeView#mOptionsTree::item,
QTreeWidget#mNavigationTree::item,    QTreeView#mNavigationTree::item,
QgsOptionsTreeView::item, QgsOptionsTreeWidget::item {
    background-color: transparent;
    color: @text;
    padding: 5px 4px;
    border: none;
    min-height: 22px;
}
QTreeWidget#mOptionsTreeView::item:hover,   QTreeView#mOptionsTreeView::item:hover,
QTreeWidget#mOptionsTreeWidget::item:hover, QTreeView#mOptionsTreeWidget::item:hover,
QTreeWidget#mOptionsTree::item:hover,       QTreeView#mOptionsTree::item:hover,
QTreeWidget#mNavigationTree::item:hover,    QTreeView#mNavigationTree::item:hover,
QgsOptionsTreeView::item:hover, QgsOptionsTreeWidget::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QTreeWidget#mOptionsTreeView::item:selected,   QTreeView#mOptionsTreeView::item:selected,
QTreeWidget#mOptionsTreeWidget::item:selected, QTreeView#mOptionsTreeWidget::item:selected,
QTreeWidget#mOptionsTree::item:selected,       QTreeView#mOptionsTree::item:selected,
QTreeWidget#mNavigationTree::item:selected,    QTreeView#mNavigationTree::item:selected,
QgsOptionsTreeView::item:selected, QgsOptionsTreeWidget::item:selected {
    background-color: @bg_selected_active;
    color: @text_bright;
}
QTreeWidget#mOptionsTreeView::item:selected:!active,   QTreeView#mOptionsTreeView::item:selected:!active,
QTreeWidget#mOptionsTreeWidget::item:selected:!active, QTreeView#mOptionsTreeWidget::item:selected:!active,
QTreeWidget#mOptionsTree::item:selected:!active,       QTreeView#mOptionsTree::item:selected:!active,
QTreeWidget#mNavigationTree::item:selected:!active,    QTreeView#mNavigationTree::item:selected:!active,
QgsOptionsTreeView::item:selected:!active, QgsOptionsTreeWidget::item:selected:!active {
    background-color: @bg_selected_inactive;
    color: @text;
}

/* ---- Tree branch column ---- */
QTreeWidget::branch,
QTreeView::branch {
    background: transparent;
}
QTreeWidget::branch:hover,
QTreeView::branch:hover {
    background-color: @bg_hover;
}
QTreeWidget::branch:selected,
QTreeView::branch:selected {
    background-color: @bg_selected_active;
}


/* =========================================================================
 * 17. LAYER STYLING DOCK (vertical icon-mode list on the left)
 * ========================================================================= */

QgsLayerStylingWidget QSplitter::handle,
QgsLayerStylingDock   QSplitter::handle {
    background-color: @border_subtle;
}

QgsLayerStylingWidget QListWidget,
QgsLayerStylingDock   QListWidget {
    background-color: @bg_statusbar;
    border: none;
    border-right: 1px solid @border_subtle;
    border-radius: 0;
    alternate-background-color: @bg_statusbar;
    min-width: 48px;
}
QgsLayerStylingWidget QListWidget::item,
QgsLayerStylingDock   QListWidget::item {
    padding: 6px 4px;
    margin: 0;
    border-radius: 0;
    border: none;
    border-left: 2px solid transparent;
    min-height: 36px;
}
QgsLayerStylingWidget QListWidget::item:hover,
QgsLayerStylingDock   QListWidget::item:hover {
    background-color: @bg_hover;
    color: @text_bright;
}
QgsLayerStylingWidget QListWidget::item:selected,
QgsLayerStylingDock   QListWidget::item:selected {
    background-color: @bg_selected_active;
    color: @text_bright;
    border-left: 2px solid @accent;
}


/* =========================================================================
 * END OF FILE
 * -------------------------------------------------------------------------
 * NOT REPRESENTABLE IN PURE QSS (documented here for completeness):
 *   - Custom QPainter rendering done by ThemedProxyStyle (checkbox tick,
 *     radio dot, tree-branch triangle, spinbox arrows).  Qt's underlying
 *     style draws acceptable defaults using the palette/QSS colours above.
 *   - Geometry/sizing logic done by WidgetFixer._fix_layer_styling: min-widths
 *     on splitter children, scrollbar policies, stretch factors, IconMode
 *     list widths, etc. — runtime widget-state, no QSS equivalent.
 *   - PluginListDelegate icon clamping (32x32). Delegates run in C++.
 *   - QPalette::PlaceholderText is compensated for via `placeholder-text-color`
 *     on QLineEdit / QgsFilterLineEdit above.
 * ========================================================================= */
